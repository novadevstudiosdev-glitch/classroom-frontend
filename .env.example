# Keys públicas del frontend
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id

# UI opcional de Truco: usar "retro" para activar TrucoTable
# NEXT_PUBLIC_TRUCO_UI=retro
